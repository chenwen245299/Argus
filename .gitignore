node_modules/
dist/
.DS_Store

src-tauri/target/
src-tauri/gen/

# PDFium dynamic library — fetched per-platform at build time by
# scripts/fetch-pdfium.mjs, bundled into the app; too big to commit.
src-tauri/lib/

# pdf.js font/cmap data — copied from node_modules at postinstall by
# scripts/setup-pdfjs-assets.js (like vditor's assets); regenerated, not committed.
public/pdfjs/

# VitePress docs build output & cache
docs/.vitepress/cache/
docs/.vitepress/dist/

# Claude Code memory (local AI assistant context — not for public repo)
.claude/

# Stray duplicate lock files
package-lock\ 2.json

# Environment variables (never commit secrets)
.env
.env.*
!.env.example

# macOS
__MACOSX/

# Secrets and key material (a second line of defence behind the gitleaks hooks —
# see .gitleaks.toml). Argus's own key store lives in a library's .argus/ folder.
*.pem
*.p12
*.pfx
*.p8
*.key
.argus/
api_keys.json
.keymaster
